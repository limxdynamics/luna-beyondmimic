# copied and modified from https://github.com/NVIDIA/warp/blob/main/.gitattributes
* text=auto
*.sh text eol=LF

# copied from https://github.com/isaac-sim/IsaacLab/blob/main/.gitattributes
*.usd filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.mtl filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.jit filter=lfs diff=lfs merge=lfs -text

# The bundled reference motion is 3.8 MB and is intentionally distributed in full. Keep it as an
# ordinary Git blob so a clean public clone does not depend on an LFS endpoint. -text still
# matters: the global `* text=auto` above would otherwise risk eol conversion on a binary.
motions/*.npy -filter -diff -merge -text

# Keep the public README figure available in clean clones without requiring LFS upload access.
docs/luna_dance_figure.png -filter -diff -merge -text
docs/limxmimic_banner.png -filter -diff -merge -text
